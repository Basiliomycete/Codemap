  {id:'c9', title:'Performance و سیستم', desc:'cache-friendly design، پروفایلینگ، و ابزارهای build مثل CMake.',
   resources:[['مستندات رسمی CMake','وبسایت','EN'],['CppCon — Performance Talks','یوتیوب','EN'],['کتاب Optimized C++ — Kurt Guntheroth','کتاب','EN'],['دانلودلی','وبسایت','فارسی']],
   project:'یک پروژه‌ی موجود رو با CMake سازمان‌دهی کن و با پروفایلر گلوگاه سرعتش رو پیدا کن.',
   ready:'آماده‌ای — این سطح یعنی می‌تونی روی یک پروژه‌ی واقعی C++ به‌صورت حرفه‌ای مشارکت کنی.'}
];

/* ---------- مسیر Python ---------- */
/* pyMain: نودهای اصلی خطی | pyBranch: دو شاخه‌ی انتخابی موازی |
   pyFinal: نود پایانی بعد از شاخه‌ها */
const pyMain = [
  {id:'p1', title:'سینتکس و مبانی', desc:'متغیرها، انواع داده، شرط و حلقه، و اجرای اولین اسکریپت.',
